{
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.json",
          "/*.css",
          "/main*.js",
          "/polyfills*.js",
          "/runtime*.js",
          "/scripts*.js"
        ]
      }
    },
    {
      "name": "lazy",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "cacheConfig": {
        "maxAge": "1d",
        "maxSize": 256,
        "timeout": "30s",
        "strategy": "performance"
      },
      "name": "api-read",
      "urls": [
        "/AbpUserConfiguration/GetAll",
        "/api/AbpUserConfiguration/GetAll",
        "/api/services/app/**/Get*",
        "/api/services/app/**/GetAll*"
      ]
    },
    {
      "cacheConfig": {
        "maxAge": "0u",
        "maxSize": 0,
        "timeout": "30s",
        "strategy": "freshness"
      },
      "name": "api-write",
      "urls": [
        "/api/services/app/**/Create*",
        "/api/services/app/**/Update*",
        "/api/services/app/**/Delete*"
      ]
    }
  ],
  "index": "/index.html"
}

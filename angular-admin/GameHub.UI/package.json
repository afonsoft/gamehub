{
  "version": "1.0.0",
  "name": "eaf-gamehub-ui",
  "displayName": "eaf-gamehub-ui",
  "description": "EAF application description",
  "main": "index.html",
  "repository": {
    "type": "git",
    "url": "https://github.com/afonsoft/EAF"
  },
  "engines": {
    "node": ">=18 <22"
  },
  "license": "MIT",
  "author": "EAF",
  "angular-cli": {},
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host localhost --port 8000",
    "build": "ng build --configuration=production --output-hashing=all --output-path dist/ --base-href=/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "sonar": "npx sonarqube-scanner",
    "service-update": "node ./node_modules/nswag/bin/nswag.js run",
    "eaf": "node ./.vscode/eaf/cli.js",
    "help": "node ./.vscode/eaf/cli.js help",
    "configure": "node ./.vscode/eaf/cli.js install",
    "eslint": "npx eslint src --debug",
    "format": "prettier --write \"./src/app/**/*.{ts,html,json}\" --ignore-unknown",
    "prepare": "node -e \"if(require('fs').existsSync('.git')){process.exit(1)}\" || husky install",
    "postinstall": "node scripts/patch-devtools-ignore-plugin.js"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --debug",
      "git add"
    ],
    "*.{ts,md,html,css,styl}": "prettier --write --ignore-unknown"
  },
  "private": true,

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL
# Use host.docker.internal:5432 para acessar o PostgreSQL do host do VPS a partir do container.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=gamehub_db
POSTGRES_USER=gamehub_user
POSTGRES_PASSWORD=

# Database provider (SqlServer, MSSQL, MySQL, PostgreSQL, Postgres, Npgsql)
Database__Provider=PostgreSQL

# Redis
# Use host.docker.internal:6379 para acessar o Redis do host do VPS a partir do container.
# abortConnect=false evita que a API caia caso o Redis ainda nao esteja disponivel no startup.
REDIS_CONNECTION=host.docker.internal:6379,abortConnect=false

# JWT
JWT_SECRET=A PREENCHER

# MinIO / S3
# A API acessa o MinIO em http://gamehub-minio:9000 quando o container sobe no mesmo compose.
# Se o MinIO estiver em outro host, ajuste para o endpoint externo (ex: http://host.docker.internal:9000).
STORAGE_PROVIDER=MinIO
MINIO_ENDPOINT=http://gamehub-minio:9000
MINIO_ACCESS_KEY=gamehub_user
MINIO_SECRET_KEY=
MINIO_BUCKET=gamehub-builds
MINIO_REGION=us-east-1
MINIO_FORCEPATHSTYLE=true

# OpenTelemetry / New Relic OTLP
# Endpoint HTTP/protobuf da New Relic. Para gRPC use https://otlp.nr-data.net:4317 e grpc.
# Obrigatorio informar o header api-key no OTEL_EXPORTER_OTLP_HEADERS para autenticar.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=api-key=SUA_API_KEY_AQUI

# Public URLs (used by API CORS, Swagger/root links and Angular admin)
# Use http:// if your local nginx does not terminate TLS.
GAMEHUB_API_URL=https://gamehub-api.afonsoft.dev
GAMEHUB_HUB_URL=https://gamehub.afonsoft.dev
GAMEHUB_ADMIN_URL=https://gamehub-admin.afonsoft.dev
GAMEHUB_CORS_ORIGINS=https://gamehub.afonsoft.dev,https://gamehub-admin.afonsoft.dev

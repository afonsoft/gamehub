{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Find_file_by_name"
    ],
    "ask": [
      "Edit",
      "Write",
      "MultiEdit",
      "Bash"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/secrets.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {}
}

<Project>

	<PropertyGroup>
		<Version>9.4.0</Version>
		<TemplateVersion>9.0.0.0</TemplateVersion>
		<PackageProjectUrl>http://www.gamehub.com.br/</PackageProjectUrl>
		<PackageLicenseUrl>https://github.com/afonsoft/gamehub/</PackageLicenseUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/afonsoft/gamehub/</RepositoryUrl>
		<Authors>AFONSOFT</Authors>
		<Company>EAF</Company>
		<Copyright>Copyright © 2025</Copyright>
		<LangVersion>14.0</LangVersion>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
		<Platform>Any CPU</Platform>
		<SelfContained>false</SelfContained>
		<NoWarn>$(NoWarn);CS1591;SYSLIB0001;SYSLIB0002;SYSLIB0003;MSB3277;NU1608</NoWarn>
		<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3253;MSB3277</MSBuildWarningsAsMessages>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
		<UseWindowsThreadPool>true</UseWindowsThreadPool>
		<PublishAot>false</PublishAot>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	</PropertyGroup>
	<!-- NU1608: Pomelo.EntityFrameworkCore.MySql 9.0.0 requires Microsoft.EntityFrameworkCore.Relational (>= 9.0.0 && <= 9.0.999), but the template targets EF Core 10. No stable Pomelo version supports EF Core 10 yet; suppress until a compatible version is available. -->
	<!-- Suppress AutoMapper 14.0.0 vulnerability (GHSA-rvv3-g6hj-g44x) - no patched free 14.x exists; Abp.AutoMapper 10.5.0 is binary-incompatible with AutoMapper >= 15.0.0. -->
	<ItemGroup>
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
		<!-- System.Security.Cryptography.Xml 10.0.7 is pulled by the .NET 10 runtime ref pack; no stable 10.x servicing fix is available yet. Suppress until Microsoft ships a patched runtime package. -->
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-23rf-6693-g89p" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-8q5v-6pqq-x66h" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-cvvh-rhrc-wg4q" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g8r8-53c2-pm3f" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-mmjf-rqrv-855v" />
	</ItemGroup>
</Project>

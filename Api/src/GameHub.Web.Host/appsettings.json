{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=gamehub;Username=gamehub;Password=A_PREENCHER"
  },
  "Database": {
    "Provider": "PostgreSQL",
    "EnableDetailedErrors": "true",
    "EnableSensitiveDataLogging": "false"
  },
  "Hangfire": {
    "IsEnabled": "true",
    "IsInMemoryDatabase": "false"
  },
  "Storage": {
    "Provider": "MinIO",
    "Minio": {
      "Endpoint": "http://localhost:9000",
      "AccessKey": "",
      "SecretKey": "",
      "Bucket": "gamehub-builds",
      "Region": "us-east-1",
      "ForcePathStyle": true
    }
  },
  "RedisCache": {
    "IsEnabled": "false",
    "ConnectionString": "localhost:6379,abortConnect=false",
    "DatabaseId": 0
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "https://otlp.nr-data.net:4318",
    "OtlpProtocol": "http/protobuf"
  },
  "DataProtection": {
    "KeysPath": "data-protection-keys"
  },
  "Authentication": {
    "JwtBearer": {
      "IsEnabled": "true",
      "SecurityKey": "REPLACE_WITH_A_STRONG_32_CHAR_KEY_OR_ENV_VAR",
      "Issuer": "GameHub",
      "Audience": "GameHub"
    }
  },
  "AdBreak": {
    "IsEnabled": true,
    "Provider": "Fake",
    "StaticVast": {
      "DefaultDurationSeconds": 15,
      "StaticMediaUrl": "",
      "SimulateAdBlocked": false
    }
  }
}
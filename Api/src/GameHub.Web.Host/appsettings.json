{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=gamehub;Username=gamehub;Password=A_PREENCHER"
  },
  "Database": {
    "Provider": "PostgreSQL",
    "EnableDetailedErrors": "true",
    "EnableSensitiveDataLogging": "false"
  },
  "Hangfire": {
    "IsEnabled": "true",
    "IsInMemoryDatabase": "false"
  },
  "Storage": {
    "Provider": "MinIO",
    "Minio": {
      "Endpoint": "http://localhost:9000",
      "AccessKey": "",
      "SecretKey": "",
      "Bucket": "gamehub-builds",
      "Region": "us-east-1",
      "ForcePathStyle": true
    }
  },
  "Cors": {
    "HubOrigins": [ "http://localhost:4200" ],
    "AdminOrigins": [ "http://localhost:4201" ]
  },
  "Authentication": {
    "JwtBearer": {
      "IsEnabled": "true",
      "SecurityKey": "REPLACE_WITH_A_STRONG_32_CHAR_KEY_OR_ENV_VAR",
      "Issuer": "GameHub",
      "Audience": "GameHub"
    }
  }
}
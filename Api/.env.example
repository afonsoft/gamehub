# SQL Server connection string
ConnectionStrings__Default=Server=sqlserver,1433;Database=EafProjectName;User Id=sa;Password=YourPassword;TrustServerCertificate=True;Encrypt=false

# Database provider (SqlServer, MSSQL, MySQL, PostgreSQL, Postgres)
Database__Provider=SqlServer

# Hangfire (background jobs)
Hangfire__IsEnabled=false
Hangfire__IsInMemoryDatabase=false

# Cache
SqlServerCache__IsEnabled=false

# Redis cache
RedisCache__IsEnabled=true
RedisCache__ConnectionString=redis:6379
RedisCache__DatabaseId=0

# Application URLs
App__ServerRootAddress=http://localhost:8001/
App__ClientRootAddress=http://localhost:8000/
App__CorsOrigins=*
